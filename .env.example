# ============================================================
# ADAPTYV SDK - Required Configuration
# ============================================================

# Your Foundry API key (required)
ADAPTYV_API_KEY=your_api_key_here

# Foundry API base URL (required)
ADAPTYV_API_URL=

# ============================================================
# Optional: Additional settings
# ============================================================

# Default organization ID
# ADAPTYV_ORGANIZATION_ID=your_org_uuid_here

# Request timeout in seconds (default: 30)
# ADAPTYV_TIMEOUT=30
