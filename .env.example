# Adaptyv SDK Configuration
# Copy to .env and fill in your values

# Required: Foundry API key (get from https://foundry.adaptyvbio.com)
ADAPTYV_API_KEY=your_api_key_here

# Optional: API type (public or internal)
# ADAPTYV_API_TYPE=public

# Optional: Custom API URL (overrides ADAPTYV_API_TYPE)
# ADAPTYV_API_URL=https://foundry-api-public.adaptyvbio.com

# Optional: Default organization ID
# ADAPTYV_ORGANIZATION_ID=your_org_uuid_here
